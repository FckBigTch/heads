CONFIG_OPENSIL_DEBUG_OUTPUT=y
CONFIG_OPENSIL_DEBUG_PREFIX=y
CONFIG_OPENSIL_DEBUG_APOB=y
CONFIG_OPENSIL_DEBUG_NBIO=y
CONFIG_OPENSIL_DEBUG_CCX=y
CONFIG_OPENSIL_DEBUG_SMU=y
CONFIG_OPENSIL_DEBUG_DF=y
CONFIG_OPENSIL_DEBUG_MEM=y
CONFIG_OPENSIL_DEBUG_FCH=y
CONFIG_OPENSIL_DEBUG_RAS=y
CONFIG_OPENSIL_DEBUG_MPIO=y
CONFIG_OPENSIL_DEBUG_CXL=y
CONFIG_OPENSIL_DEBUG_SDXI=y
CONFIG_OPENSIL_DEBUG_RCMGR=y
CONFIG_OPENSIL_DEBUG_GFX=y
CONFIG_OPENSIL_DEBUG_PROM=y
