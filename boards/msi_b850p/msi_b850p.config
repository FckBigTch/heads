# MSI PRO B850-P (DDR5) board configuration
# CAVEATS: TPM_GPIO_RESET=VULNERABLE (unconfirmed) -- GPIO lock missing, attack not hardware-tested
# See doc/TPM_GPIO_Reset_Vulnerability.md for details.
export CONFIG_COREBOOT=y
export CONFIG_COREBOOT_VERSION=dasharo_msi_b850
export CONFIG_LINUX_VERSION=6.6.30

CONFIG_COREBOOT_CONFIG=config/coreboot-msi_b850p.config
export CONFIG_COREBOOT_TOOLCHAIN_X64=y
CONFIG_LINUX_CONFIG=config/linux-msi_b850p.config

CONFIG_KEXEC=y
CONFIG_QRENCODE=y
CONFIG_TPMTOTP=y
CONFIG_POPT=y
CONFIG_FLASHTOOLS=y
CONFIG_FLASHPROG=y
CONFIG_PCIUTILS=y
CONFIG_UTIL_LINUX=y
CONFIG_CRYPTSETUP2=y
CONFIG_GPG2=y
CONFIG_LVM2=y
CONFIG_MBEDTLS=y

CONFIG_DROPBEAR=n

CONFIG_HOTPKEY=n

CONFIG_CAIRO=y
CONFIG_FBWHIPTAIL=y

CONFIG_LINUX_USB=y
CONFIG_LINUX_IGC=y

export CONFIG_REQUIRE_USB_KEYBOARD=y

export CONFIG_BOOTSCRIPT=/bin/gui-init.sh

export CONFIG_BOOT_KERNEL_ADD=""
export CONFIG_BOOT_KERNEL_REMOVE=""

# TPM2 requirements
export CONFIG_TPM2_TOOLS=y
export CONFIG_PRIMARY_KEY_TYPE=ecc
CONFIG_TPM2_TSS=y
CONFIG_OPENSSL=y

export CONFIG_BOOT_DEV="/dev/nvme0n1"
export CONFIG_BOARD_NAME="MSI PRO B850-P"
export CONFIG_FLASH_OPTIONS="flashprog --progress --programmer internal"
